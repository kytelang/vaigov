// --- accessors --------------------------------------------------------------

/// The full built-in control library across every embedded framework. The Rust
/// source parses this from embedded YAML and caches it; here it is rebuilt from
/// the framework builders on each call (cheap for this bounded subset).
pub fn library(): List<Control> {
    let out = List<Control>();
    addEuAiAct(out);
    addNistAiRmf(out);
    addIso42001(out);
    addSoc2(out);
    // The remaining frameworks, ported faithfully from the acp catalogue YAML so
    // the full 12-act catalogue is present (every node a paraphrase + citation).
    addGdpr(out);
    addIso23894(out);
    addIso27001(out);
    addCanadaAida(out);
    addColoradoAiAct(out);
    addDpdp2023(out);
    addNycLl144(out);
    addUkAi(out);
    return out;
}

/// Controls for one framework.
pub fn forFramework(framework: string): List<Control> {
    let out = List<Control>();
    let all = library();
    let i = 0;
    while (i < all.size()) {
        let c = all.at(i);
        if (string.eql(c.framework, framework)) { out.push(c); }
        i = i + 1;
    }
    return out;
}

/// Look up a control by (framework, id). Returns undefined when absent.
pub fn get(framework: string, id: string): Control | undefined {
    let all = library();
    let i = 0;
    while (i < all.size()) {
        let c = all.at(i);
        if (string.eql(c.framework, framework) && string.eql(c.id, id)) { return c; }
        i = i + 1;
    }
    return undefined;
}

/// All framework metadata (label, version, type, record-keeping reference).
pub fn frameworks(): List<Framework> {
    let out = List<Framework>();
    out.push(Framework("eu-ai-act", "EU AI Act", "2024", "statutory_conformity", "2024-08-01", "Art. 12", "Regulation (EU) 2024/1689"));
    out.push(Framework("nist-ai-rmf", "NIST AI Risk Management Framework", "1.0", "principles_based", "2023-01-26", "MANAGE 1.1", "NIST AI 100-1"));
    out.push(Framework("iso-42001", "ISO/IEC 42001", "2023", "standard", "2023-12-18", "A.4.2", "ISO/IEC 42001:2023"));
    out.push(Framework("soc-2", "SOC 2", "2017", "standard", "2017-05-01", "CC7.2", "AICPA TSC 2017"));
    out.push(Framework("gdpr", "GDPR", "2016", "statutory_conformity", "2018-05-25", "Art. 30 (records of processing)", "Regulation (EU) 2016/679"));
    out.push(Framework("iso-23894", "ISO/IEC 23894", "2023", "standard", "2023-02-01", "Clause 6 (risk management process)", "ISO/IEC 23894:2023"));
    out.push(Framework("iso-27001", "ISO/IEC 27001", "2022", "standard", "2022-10-25", "A.8.15 (logging)", "ISO/IEC 27001:2022"));
    out.push(Framework("canada-aida", "Canada AIDA", "2022", "statutory_conformity", "", "Record-keeping obligations", "Artificial Intelligence and Data Act (Bill C-27, as introduced 2022)"));
    out.push(Framework("colorado-ai-act", "Colorado AI Act (SB 24-205)", "2024", "statutory_conformity", "2026-06-30", "6-1-1703 (risk management policy and programme)", "Colorado SB 24-205"));
    out.push(Framework("dpdp-2023", "India DPDP Act 2023", "2023", "statutory_conformity", "2023-08-11", "s8 (data fiduciary obligations)", "Digital Personal Data Protection Act, 2023 (India)"));
    out.push(Framework("nyc-ll144", "NYC Local Law 144", "2023", "sectoral", "2023-07-05", "Bias audit publication", "NYC Local Law 144 of 2021; DCWP final rules"));
    out.push(Framework("uk-ai", "UK AI principles", "2023", "principles_based", "2023-03-29", "Accountability and governance", "UK pro-innovation AI regulation white paper (2023)"));
    return out;
}

/// Metadata for one framework slug, or undefined when absent.
pub fn framework(slug: string): Framework | undefined {
    let fws = frameworks();
    let i = 0;
    while (i < fws.size()) {
        let f = fws.at(i);
        if (string.eql(f.slug, slug)) { return f; }
        i = i + 1;
    }
    return undefined;
}

// Resolve a crosswalk target token within a framework: match a control whose id
// OR reference equals the token (the catalogue uses both forms). Returns the
// resolved control id, or undefined when nothing matches.
fn resolveTarget(targetFramework: string, token: string): string | undefined {
    let cs = forFramework(targetFramework);
    let i = 0;
    while (i < cs.size()) {
        let c = cs.at(i);
        if (string.eql(c.id, token) || string.eql(c.reference, token)) { return c.id; }
        i = i + 1;
    }
    return undefined;
}

/// Resolved crosswalk edges across the whole catalogue. For each control that
/// declares crosswalk targets ("framework:token"), the resolved (from) -> (to)
/// pair as (framework, control id). The token may be a control id or a reference;
/// it is resolved against the target framework's controls. Unresolvable targets
/// are dropped (mirrors the Rust `filter_map`).
pub fn crosswalkEdges(): List<CrosswalkEdge> {
    let out = List<CrosswalkEdge>();
    let all = library();
    let i = 0;
    while (i < all.size()) {
        let c = all.at(i);
        let j = 0;
        while (j < c.crosswalk.size()) {
            let x = c.crosswalk.at(j);
            let colon = string.indexOf(x, ":");
            if (colon > 0) {
                let fw = string.trim(string.slice(x, 0, colon));
                let token = string.trim(string.slice(x, colon + 1, string.len(x)));
                let targetId = resolveTarget(fw, token);
                if (targetId != undefined) {
                    out.push(CrosswalkEdge(c.framework, c.id, fw, targetId ?? ""));
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}
