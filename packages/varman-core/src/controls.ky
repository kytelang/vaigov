//! Control catalogue (compliance layer).
//!
//! A port of Rust `acp-core`'s `controls.rs`. In Rust the catalogue is versioned
//! YAML data, one file per framework-version, embedded at build time and parsed.
//! Here we embed a REPRESENTATIVE but real subset as data: the loader (`library`)
//! calls one builder per framework, and each builder pushes real controls with
//! their real normative references ("Art. 14", "GOVERN 1.1", "A.9.2", "CC6.1").
//! The shape is deliberately data-driven: adding a framework is adding a builder
//! and one call in `library`, and adding a control is one `makeControl` line.
//!
//! The embedded subset is: eu-ai-act@2024, nist-ai-rmf@1.0, iso-42001@2023 and
//! soc-2@2017. See the `// TODO: full catalogue` marker in `library` for where
//! the remaining frameworks and the full per-framework control sets attach.
//!
//! Each `Control` carries the exhaustive-conformance fields from the Rust source
//! (hierarchy path, normative reference, obligation type, bound roles,
//! applicability predicate, evidence type, assessment method, crosswalk and
//! citation). Control ids are the one source of truth the assessment and
//! conformance engines draw from.

import string;
import list;

/// One control (a single normative obligation) in a framework. A reference type:
/// it owns three growable lists (`path`, `roles`, `crosswalk`), so it is modelled
/// as a class to carry those containers without per-copy ownership concerns.
pub class Control {
    pub framework: string,
    pub id: string,
    pub title: string,
    pub description: string,
    pub requiredEvidence: string,
    /// Hierarchy path, for example ["Chapter III", "Section 2", "Article 14"].
    pub path: List<string>,
    /// Normative reference, for example "Art. 14", "A.8.2", "CC6.1", "GOVERN 1.1".
    pub reference: string,
    /// govern | document | technical | process | transparency | oversight |
    /// record-keeping | prohibition.
    pub obligationType: string,
    /// The roles this obligation binds. Empty means it binds any role.
    pub roles: List<string>,
    /// Applicability predicate over a subject profile, for example
    /// "risk_tier in [high]", "role=deployer", "asset_type=gpai". Default "always".
    pub applicability: string,
    /// attestation | artefact | test | ledger.
    pub assessmentMethod: string,
    /// Equivalent controls in other frameworks, as "framework:id".
    pub crosswalk: List<string>,
    /// Citation to the official source (regulation article, standard clause).
    pub citation: string,

    init(framework: string, id: string, title: string, description: string, requiredEvidence: string, path: List<string>, reference: string, obligationType: string, roles: List<string>, applicability: string, assessmentMethod: string, crosswalk: List<string>, citation: string) {
        self.framework = framework;
        self.id = id;
        self.title = title;
        self.description = description;
        self.requiredEvidence = requiredEvidence;
        self.path = path;
        self.reference = reference;
        self.obligationType = obligationType;
        self.roles = roles;
        self.applicability = applicability;
        self.assessmentMethod = assessmentMethod;
        self.crosswalk = crosswalk;
        self.citation = citation;
    }
}

/// Framework-level metadata (one per catalogue file in the Rust source).
pub struct Framework {
    pub slug: string,
    pub label: string,
    pub version: string,
    /// statutory_conformity | principles_based | standard | sectoral.
    pub frameworkType: string,
    pub effectiveDate: string,
    /// The record-keeping (or equivalent) reference used in the signed envelope.
    pub recordKeepingReference: string,
    pub source: string,

    init(slug: string, label: string, version: string, frameworkType: string, effectiveDate: string, recordKeepingReference: string, source: string) {
        self.slug = slug;
        self.label = label;
        self.version = version;
        self.frameworkType = frameworkType;
        self.effectiveDate = effectiveDate;
        self.recordKeepingReference = recordKeepingReference;
        self.source = source;
    }
}

/// A resolved crosswalk edge: a (framework, id) that maps to a (framework, id)
/// in another framework. Produced by `crosswalkEdges`.
pub struct CrosswalkEdge {
    pub fromFramework: string,
    pub fromId: string,
    pub toFramework: string,
    pub toId: string,

    init(fromFramework: string, fromId: string, toFramework: string, toId: string) {
        self.fromFramework = fromFramework;
        self.fromId = fromId;
        self.toFramework = toFramework;
        self.toId = toId;
    }
}

/// Split a comma-separated field ("a, b, c") into a trimmed, non-empty list. An
/// empty or whitespace-only input yields the empty list (binds any / no edges).
fn splitCsv(s: string): List<string> {
    let out = List<string>();
    let t = string.trim(s);
    if (string.len(t) == 0) { return out; }
    let parts = string.split(t, ",");
    let i = 0;
    while (i < parts.size()) {
        let p = string.trim(parts.at(i));
        if (string.len(p) > 0) { out.push(p); }
        i = i + 1;
    }
    return out;
}

/// Build a `Control` from the common scalar fields, taking `roles` and
/// `crosswalk` as comma-separated strings. This is the data-driven unit the
/// framework builders (and tests) use; the less-common fields default to empty.
pub fn makeControl(framework: string, id: string, title: string, reference: string, obligationType: string, applicability: string, rolesCsv: string, crosswalkCsv: string): Control {
    return Control(framework, id, title, "", "", List<string>(), reference, obligationType, splitCsv(rolesCsv), applicability, "", splitCsv(crosswalkCsv), "");
}

// --- embedded framework builders -------------------------------------------

// EU AI Act (Regulation (EU) 2024/1689): statutory conformity. Art. 5
// prohibitions always apply; the Chapter III high-risk duties gate on the high
// tier; Art. 27 (FRIA) binds deployers, not a pure provider.
fn addEuAiAct(out: List<Control>): void {
    out.push(makeControl("eu-ai-act", "art-5-a", "Prohibited AI practices", "Art. 5", "prohibition", "always", "provider,deployer", ""));
    out.push(makeControl("eu-ai-act", "art-9", "Risk management system", "Art. 9", "process", "risk_tier in [high]", "provider", ""));
    out.push(makeControl("eu-ai-act", "art-10", "Data and data governance", "Art. 10", "process", "risk_tier in [high]", "provider", "iso-42001:A.7.2"));
    out.push(makeControl("eu-ai-act", "art-11", "Technical documentation", "Art. 11", "document", "risk_tier in [high]", "provider", ""));
    out.push(makeControl("eu-ai-act", "art-12", "Record-keeping", "Art. 12", "record-keeping", "risk_tier in [high]", "provider", "soc-2:CC7.2"));
    out.push(makeControl("eu-ai-act", "art-13", "Transparency and provision of information", "Art. 13", "transparency", "risk_tier in [high, limited]", "provider", ""));
    out.push(makeControl("eu-ai-act", "art-14", "Human oversight", "Art. 14", "oversight", "risk_tier in [high]", "provider", "nist-ai-rmf:MANAGE 2.2"));
    out.push(makeControl("eu-ai-act", "art-15", "Accuracy, robustness and cybersecurity", "Art. 15", "technical", "risk_tier in [high]", "provider", ""));
    out.push(makeControl("eu-ai-act", "art-27", "Fundamental rights impact assessment", "Art. 27", "process", "risk_tier in [high]", "deployer", "iso-42001:A.5.2"));
    out.push(makeControl("eu-ai-act", "annex-iv-1", "Technical documentation content", "Annex IV", "document", "risk_tier in [high]", "provider", ""));
}

// NIST AI RMF 1.0 (NIST AI 100-1): principles based, GOVERN/MAP/MEASURE/MANAGE.
fn addNistAiRmf(out: List<Control>): void {
    out.push(makeControl("nist-ai-rmf", "govern-1.1", "Legal and regulatory requirements understood and managed", "GOVERN 1.1", "govern", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "govern-2.1", "Roles, responsibilities and lines of communication", "GOVERN 2.1", "govern", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "map-1.1", "Context is established and understood", "MAP 1.1", "process", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "map-2.3", "Scientific integrity and TEVV considerations", "MAP 2.3", "process", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "measure-2.1", "Test sets and metrics are documented", "MEASURE 2.1", "technical", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "measure-2.7", "AI security and resilience are evaluated", "MEASURE 2.7", "technical", "always", "", "eu-ai-act:art-15"));
    out.push(makeControl("nist-ai-rmf", "manage-1.1", "Risks are prioritised and responded to", "MANAGE 1.1", "process", "always", "", ""));
    out.push(makeControl("nist-ai-rmf", "manage-2.2", "Mechanisms for human oversight are in place", "MANAGE 2.2", "oversight", "always", "", ""));
}

// ISO/IEC 42001:2023: AI management system, Annex A controls.
fn addIso42001(out: List<Control>): void {
    out.push(makeControl("iso-42001", "A.2.2", "AI policy", "A.2.2", "govern", "always", "", ""));
    out.push(makeControl("iso-42001", "A.4.2", "Documentation of AI system resources", "A.4.2", "document", "always", "", ""));
    out.push(makeControl("iso-42001", "A.5.2", "AI system impact assessment process", "A.5.2", "process", "always", "", "eu-ai-act:art-27"));
    out.push(makeControl("iso-42001", "A.6.2", "AI system life cycle management", "A.6.2", "process", "always", "", ""));
    out.push(makeControl("iso-42001", "A.7.2", "Data for AI systems", "A.7.2", "process", "always", "", ""));
    out.push(makeControl("iso-42001", "A.9.2", "Information for interested parties", "A.9.2", "transparency", "always", "", ""));
    out.push(makeControl("iso-42001", "A.10.2", "Allocating responsibilities with suppliers", "A.10.2", "process", "always", "", ""));
}

