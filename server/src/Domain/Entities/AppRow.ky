// Persistence entity: one row of the `apps` table (the applications that register
// agents). Persistence-agnostic; the AppDto view projection is derived from it by
// the feature mapper. Snake_case fields match the Postgres columns.
@serializable
pub struct AppRow {
    pub id: string,
    pub name: string,
    pub owner: string,
    pub metadata_json: string,
    pub tenant: string,
    pub created_ms: long,
}
