// Policy view as KYX (acp/console PolicyView.vue, functional rule editor): the
// authored rule set with New rule / edit / delete and a modal form (name,
// description, verdict, match surface, approver, priority, enabled). The Vue's
// visual match-builder + test console are a later enhancement; this authors the
// real rules that compile to OPA. Datastar forms post to /console/policy/*.
import list;
import string;
import Domain.Dtos.RuleListRow;

fn jsq(s: string): string { let a = string.replace(s, "\\", "\\\\"); return string.replace(a, "'", "\\'"); }
fn dash(s: string): string { if (s.length == 0) { return "-"; } return s; }

fn verdictBadge(v: string): Html {
    if (string.eql(v, "allow")) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{v}</span>; }
    else if (string.eql(v, "deny")) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-bad">{v}</span>; }
    else if (v.length == 0) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">-</span>; }
    return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-warn">{v}</span>;
}
fn enabledBadge(enabled: int): Html {
    if (enabled != 0) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">on</span>; }
    return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-muted">off</span>;
}

fn ruleRow(r: RuleListRow): Html {
    let en = r.enabled != 0;
    let openEdit = "$plId='" + jsq(r.rule_id) + "'; $plName='" + jsq(r.name) + "'; $plDesc='" + jsq(r.description)
        + "'; $plVerdict='" + jsq(r.verdict) + "'; $plResource='" + jsq(r.resource) + "'; $plOperation='" + jsq(r.operation)
        + "'; $plApprover='" + jsq(r.approver_group) + "'; $plPriority='" + `${r.priority}` + "'; $plEnabled=" + (if (en) ("true") else ("false"))
        + "; $plErr=''; $plModal='open'";
    let delExpr = "$plId='" + jsq(r.rule_id) + "'; @post('/console/policy/delete')";
    let surface = dash(r.resource) + " · " + dash(r.operation);
    return <tr class="border-b border-line align-top">
        <td class="py-2 pr-4">
            <div class="text-sm text-txt">{r.name}</div>
            {if (r.description.length > 0) { <div class="text-xs text-dim">{r.description}</div>; }}
        </td>
        <td class="py-2 pr-4">{verdictBadge(r.verdict)}</td>
        <td class="py-2 pr-4 text-xs text-dim">{surface}</td>
        <td class="py-2 pr-4 text-xs text-dim">{dash(r.approver_group)}</td>
        <td class="py-2 pr-4 text-sm">{`${r.priority}`}</td>
        <td class="py-2 pr-4">{enabledBadge(r.enabled)}</td>
        <td class="py-2 pr-4 text-right whitespace-nowrap">
            <button class="text-xs text-dim hover:text-txt mr-3" data-on:click={openEdit}>Edit</button>
            <button class="text-xs text-bad hover:underline" data-on:click={delExpr}>Delete</button>
        </td>
    </tr>;
}

fn plField(labelText: string, bind: string, placeholder: string): Html {
    return <label class="text-xs text-dim">{labelText}
        <input type="text" data-bind={bind} class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder={placeholder} />
    </label>;
}

pub fn policyPanel(rules: list.List<RuleListRow>, regoText: string, testVerdict: string, testRule: string): Html {
    let sigs = "{plRegoOpen: '', plMsg: '', ptSubject: '', ptRoles: '', ptOp: '', ptResource: '', ptClass: ''}";
    return <div id="policy" data-signals={sigs} class="grid gap-4">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-accent">{`${rules.size()} rules`}</span>
            <span class="text-dim text-sm">Authored in the UI and compiled to OPA. Higher priority wins.</span>
            <div class="ml-auto flex items-center gap-2">
                <button class="rounded-lg border border-line2 px-3 py-1.5 text-sm hover:bg-panel2" data-on:click="@get('/console/policy/rego')">View Rego</button>
                <a href="/v1/bundles/policy" class="rounded-lg border border-line2 px-3 py-1.5 text-sm hover:bg-panel2">Download OPA bundle</a>
                <button class="rounded-lg border border-line2 px-3 py-1.5 text-sm hover:bg-panel2" data-on:click="@post('/console/policy/compile')">Compile to OPA</button>
                <button class="rounded-lg bg-accent text-white px-3.5 py-1.5 text-sm font-medium hover:opacity-90"
                    data-on:click="$plId=''; $plName=''; $plDesc=''; $plVerdict='deny'; $plResource=''; $plOperation=''; $plApprover=''; $plPriority='100'; $plEnabled=true; $plErr=''; $plModal='open'">New rule</button>
            </div>
        </div>
        <div data-show="$plMsg != ''" class="text-ok text-sm" data-text="$plMsg"></div>
        <div data-show="$plErr != ''" class="text-bad text-sm" data-text="$plErr"></div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead><tr class="text-left text-[11px] uppercase tracking-wider text-muted">
                        <th class="py-2 pr-4">Rule</th><th class="py-2 pr-4">Verdict</th><th class="py-2 pr-4">Match (resource · op)</th><th class="py-2 pr-4">Approver</th><th class="py-2 pr-4">Priority</th><th class="py-2 pr-4">Enabled</th><th class="py-2 pr-4"></th>
                    </tr></thead>
                    <tbody>
                        {for (i in 0..rules.size()) { ruleRow(rules.at(i)); }}
                        {if (rules.size() == 0) {
                            <tr><td colspan="7" class="py-10 text-center text-dim">No policy rules yet. Install a policy pack or author a rule to start governing AI traffic.</td></tr>;
                        }}
                    </tbody>
                </table>
            </div>
        </div>

        <div data-show="$plModal === 'open'" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
            <div class="bg-panel border border-line rounded-2xl p-6 w-full max-w-lg">
                <h3 class="font-semibold text-txt" data-text="$plId == '' ? 'New policy rule' : 'Edit policy rule'">New policy rule</h3>
                <div class="grid sm:grid-cols-2 gap-3 mt-4">
                    {plField("Name", "plName", "e.g. block PII to external")}
                    <label class="text-xs text-dim">Verdict
                        <select data-bind="plVerdict" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm">
                            <option value="deny">deny</option><option value="allow">allow</option><option value="step_up">step_up</option><option value="shadow">shadow</option>
                        </select>
                    </label>
                    {plField("Match resource", "plResource", "e.g. api.openai.com")}
                    {plField("Match operation", "plOperation", "e.g. chat.completions")}
                    {plField("Approver group", "plApprover", "e.g. security")}
                    {plField("Priority", "plPriority", "100")}
                    <label class="text-xs text-dim">Enabled
                        <select data-bind="plEnabled" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm">
                            <option value="true">on</option><option value="false">off</option>
                        </select>
                    </label>
                    <label class="text-xs text-dim sm:col-span-2">Description
                        <input type="text" data-bind="plDesc" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="what this rule enforces" />
                    </label>
                    <div class="col-span-full flex justify-end gap-2 pt-1">
                        <button class="rounded-lg border border-line2 px-4 py-2 text-sm hover:bg-panel2" data-on:click="$plModal=''">Cancel</button>
                        <button class="rounded-lg bg-accent text-white px-4 py-2 text-sm font-medium hover:opacity-90"
                            data-on:click="@post('/console/policy/save')" data-text="$plId == '' ? 'Create rule' : 'Save'">Create rule</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-3 border-b border-line">
                <h2 class="font-semibold text-txt">Test a request</h2>
                <p class="text-xs text-dim">Evaluate a sample request through the authored rules in-process and see the verdict OPA would return.</p>
            </div>
            <div class="px-5 py-4 grid gap-3">
                <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <label class="text-xs text-dim">Subject id
                        <input type="text" data-bind="ptSubject" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="alice" /></label>
                    <label class="text-xs text-dim">Subject roles (comma)
                        <input type="text" data-bind="ptRoles" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="deployer" /></label>
                    <label class="text-xs text-dim">Operation
                        <input type="text" data-bind="ptOp" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="chat.completions" /></label>
                    <label class="text-xs text-dim">Resource id
                        <input type="text" data-bind="ptResource" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="api.openai.com" /></label>
                    <label class="text-xs text-dim">Classification
                        <input type="text" data-bind="ptClass" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder="confidential" /></label>
                </div>
                <div class="flex items-center gap-3">
                    <button class="rounded-lg bg-accent text-white px-4 py-2 text-sm font-medium hover:opacity-90" data-on:click="@post('/console/policy/test')">Evaluate</button>
                    {if (testVerdict.length > 0) {
                        <span class="flex items-center gap-2">
                            {verdictBadge(testVerdict)}
                            {if (testRule.length > 0) { <span class="text-xs text-dim">matched rule <span class="font-mono text-txt">{testRule}</span></span>; }}
                            {if (testRule.length == 0) { <span class="text-xs text-dim">default verdict (no rule matched)</span>; }}
                        </span>;
                    }}
                </div>
            </div>
        </div>

        <div data-show="$plRegoOpen === 'open'" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
            <div class="bg-panel border border-line2 rounded-2xl p-6 w-full max-w-3xl">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-txt">Compiled Rego</h3>
                    <button class="text-dim hover:text-txt text-lg leading-none" data-on:click="$plRegoOpen=''">×</button>
                </div>
                <pre class="bg-panel2 border border-line rounded-md p-3 text-xs font-mono text-txt overflow-auto max-h-[70vh] whitespace-pre">{regoText}</pre>
            </div>
        </div>
    </div>;
}
