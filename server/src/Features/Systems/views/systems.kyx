// AI systems view as KYX (full parity with acp/console SystemsView.vue): the
// governed AI estate with New system / edit / delete and an add-edit modal.
// Datastar forms post to /console/systems/* (see SystemsConsole/handler.ky).
import list;
import string;
import Domain.Dtos.SystemDtos;

fn jsq(s: string): string {
    let a = string.replace(s, "\\", "\\\\");
    return string.replace(a, "'", "\\'");
}

// Display/edit form value for a jurisdictions JSON string (`["UK","EU"]` -> `UK, EU`).
fn jurCsv(jsonStr: string): string {
    let a = string.replace(jsonStr, "[", "");
    let b = string.replace(a, "]", "");
    return string.replace(b, "\"", "");
}

fn sysTierBadge(t: string): Html {
    if (t.length == 0) { return <span class="text-dim">-</span>; }
    if (string.eql(t, "high") || string.eql(t, "unacceptable")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-bad">{t}</span>;
    } else if (string.eql(t, "limited")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-warn">{t}</span>;
    } else if (string.eql(t, "minimal")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{t}</span>;
    }
    return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">{t}</span>;
}

fn sysDash(s: string): string { if (s.length == 0) { return "-"; } return s; }

fn systemRow(s: SystemRow): Html {
    let openEdit = "$sysId='" + jsq(s.id) + "'; $sysName='" + jsq(s.name) + "'; $sysOwner='" + jsq(s.owner)
        + "'; $sysTier='" + jsq(s.risk_tier) + "'; $sysSector='" + jsq(s.sector)
        + "'; $sysJur='" + jsq(jurCsv(s.jurisdictions)) + "'; $sysPurpose='" + jsq(s.purpose)
        + "'; $sysErr=''; $sysModal='open'";
    let delExpr = "$sysId='" + jsq(s.id) + "'; @post('/console/systems/delete')";
    let openDetail = "@get('/systems/detail/" + jsq(s.id) + "/view')";
    return <tr class="border-b border-line align-top">
        <td class="py-2 pr-4">
            <div class="text-sm text-txt">{s.name}</div>
            <div class="font-mono text-[10px] text-muted">{s.id}</div>
        </td>
        <td class="py-2 pr-4 text-dim text-sm">{sysDash(s.owner)}</td>
        <td class="py-2 pr-4">{sysTierBadge(s.risk_tier)}</td>
        <td class="py-2 pr-4 text-sm">{sysDash(s.sector)}</td>
        <td class="py-2 pr-4 text-dim text-sm">{sysDash(s.lifecycle_state)}</td>
        <td class="py-2 pr-4 text-right whitespace-nowrap">
            <button class="text-xs text-accent hover:underline mr-3" data-on:click={openDetail}>Open</button>
            <button class="text-xs text-dim hover:text-txt mr-3" data-on:click={openEdit}>Edit</button>
            <button class="text-xs text-bad hover:underline" data-on:click={delExpr}>Delete</button>
        </td>
    </tr>;
}

fn sysField(labelText: string, bind: string, placeholder: string): Html {
    return <label class="text-xs text-dim">{labelText}
        <input type="text" data-bind={bind} class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm" placeholder={placeholder} />
    </label>;
}

pub fn systemsPanel(rows: list.List<SystemRow>): Html {
    return <div id="systems" class="grid gap-4">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-accent">{`${rows.size()} systems`}</span>
            <span class="text-dim text-sm">The governed AI estate. Each system anchors its roles, assessments, risks, evidence and reports.</span>
            <div class="ml-auto">
                <button class="rounded-lg bg-accent text-white px-3.5 py-1.5 text-sm font-medium hover:opacity-90"
                    data-on:click="$sysId=''; $sysName=''; $sysOwner=''; $sysTier='high'; $sysSector=''; $sysJur=''; $sysPurpose=''; $sysErr=''; $sysModal='open'">New system</button>
            </div>
        </div>
        <div data-show="$sysErr != ''" class="text-bad text-sm" data-text="$sysErr"></div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead><tr class="text-left text-[11px] uppercase tracking-wider text-muted">
                        <th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Owner</th><th class="py-2 pr-4">Risk tier</th><th class="py-2 pr-4">Sector</th><th class="py-2 pr-4">Lifecycle</th><th class="py-2 pr-4"></th>
                    </tr></thead>
                    <tbody>
                        {for (i in 0..rows.size()) { systemRow(rows.at(i)); }}
                        {if (rows.size() == 0) {
                            <tr><td colspan="6" class="py-10 text-center text-dim">No AI systems registered.</td></tr>;
                        }}
                    </tbody>
                </table>
            </div>
        </div>

        <div data-show="$sysModal === 'open'" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
            <div class="bg-panel border border-line rounded-2xl p-6 w-full max-w-lg">
                <h3 class="font-semibold text-txt" data-text="$sysId == '' ? 'New AI system' : 'Edit AI system'">New AI system</h3>
                <div class="grid sm:grid-cols-2 gap-3 mt-4">
                    {sysField("Name", "sysName", "e.g. Resume Screener")}
                    {sysField("Owner", "sysOwner", "team / owner")}
                    <label class="text-xs text-dim">Risk tier
                        <select data-bind="sysTier" class="mt-1 block w-full bg-panel2 border border-line rounded-md px-2 py-1.5 text-sm">
                            <option value="high">high</option><option value="limited">limited</option><option value="minimal">minimal</option><option value="unacceptable">unacceptable</option>
                        </select>
                    </label>
                    {sysField("Sector", "sysSector", "e.g. hr, finance")}
                    {sysField("Jurisdictions (comma-separated)", "sysJur", "e.g. UK, EU")}
                    {sysField("Purpose", "sysPurpose", "intended purpose")}
                    <div class="col-span-full flex justify-end gap-2 pt-1">
                        <button class="rounded-lg border border-line2 px-4 py-2 text-sm hover:bg-panel2" data-on:click="$sysModal=''">Cancel</button>
                        <button class="rounded-lg bg-accent text-white px-4 py-2 text-sm font-medium hover:opacity-90"
                            data-on:click="@post('/console/systems/save')" data-text="$sysId == '' ? 'Register system' : 'Save'">Register system</button>
                    </div>
                </div>
            </div>
        </div>
    </div>;
}
