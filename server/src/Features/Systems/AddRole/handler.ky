// POST /systems/{id}/roles {role,jurisdiction,market_date} -> {"ok":true,"id":"role-.."}.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import crypto.random;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Systems.Shared.SystemRepository;
import Features.Systems.Shared.systemhelp;

pub struct AddRoleHandler impl RouteHandler {
    repo: SystemRepository,
    app: AppContext,
    init(repo: SystemRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: AddRoleHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditGrc)) { return Http.forbidden(); }
        let id = ctx.param("id");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let body = Http.bodyJson(ctx);
        let role = systemhelp.sysStr(body, "role");
        if (role.length == 0) {
            let e = Map<string, json.JsonValue>(2, string.hash);
            e.set("ok", json.bool(false)); e.set("error", json.str("role is required"));
            return Http.okObj(e);
        }
        let srows = await self.repo.getSystem(id, tenant);
        if (srows.items.size() == 0) {
            let e = Map<string, json.JsonValue>(2, string.hash);
            e.set("ok", json.bool(false)); e.set("error", json.str(string.concat(string.concat("unknown system '", id), "'")));
            return Http.okObj(e);
        }
        let rid = string.concat("role-", random.randomHex(6));
        let now = Http.nowMs();
        await self.repo.addRole(rid, id, role, systemhelp.sysStr(body, "jurisdiction"), systemhelp.sysStr(body, "market_date"), tenant, now);
        await self.repo.addAudit(string.concat("aud-", random.randomHex(6)), id, "role-added", "system", role, tenant, now);
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("ok", json.bool(true)); m.set("id", json.str(rid));
        return Http.okObj(m);
    }
}
