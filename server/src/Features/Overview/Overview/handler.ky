// GET /overview -> the Overview dashboard as a Datastar fragment. Read-only:
// decision posture from the in-memory decision read-side, evidence-record count
// from Postgres, authored-control coverage from the active rules vs the control
// library.
import web.routing;
import web.response;
import ds_response;
import string;
import list;
import data.db;
import controls;
import Shared.AppContext;
import Shared.TrustState;
import Features.Overview.views.overview;

pub struct OverviewHandler impl RouteHandler {
    app: AppContext,
    init(app: AppContext) { self.app = app; }

    async fn serve(self: OverviewHandler, ctx: Context): Response {
        // Decision posture, tallied from the observed-decision read-side.
        let decs = self.app.trust.decisions;
        let allow: long = 0;
        let stepUp: long = 0;
        let shadow: long = 0;
        let deny: long = 0;
        let i = 0;
        while (i < decs.size()) {
            let vd = decs.get(i);
            if (vd != undefined) {
                let verd = (vd ?? DecisionEntry("", "", "", list.List<string>(), "", "", "", "", 0)).verdict;
                if (string.eql(verd, "allow")) { allow = allow + 1; }
                else if (string.eql(verd, "deny")) { deny = deny + 1; }
                else if (string.eql(verd, "step_up")) { stepUp = stepUp + 1; }
                else if (string.eql(verd, "shadow")) { shadow = shadow + 1; }
            }
            i = i + 1;
        }

        // Evidence-record count from Postgres. Read via the raw ResultSet path
        // (prepare/queryPrepared) rather than a typed `Repository<CountRow>`: the
        // generated value-struct `Rows<T>` destructor segfaults in cleanup here,
        // so we read the scalar off `db.Row` (hand-written stdlib, sound dtor).
        let evid: long = 0;
        let conn = await self.app.db.pool.acquire();
        let stmt = await conn.prepare("SELECT count(*) AS n FROM evidence");
        let rs = await conn.queryPrepared(stmt, list.List<DbValue>());
        self.app.db.pool.release(conn);
        if (rs.rows.size() > 0) { evid = (rs.rows.get(0) ?? Row()).getLong(0); }

        // Authored-control coverage: active rules vs the control library (a simple
        // ratio; the exact /compliance/coverage summary is a later slice).
        let totalControls = controls.library().size();
        let authored = self.app.trust.rules.size();
        if (authored > totalControls) { authored = totalControls; }
        let covPct: int = if (totalControls > 0) (authored * 100 / totalControls) else (0);

        let hasPolicy = self.app.trust.rules.size() > 0;
        let hasDecisions = decs.size() > 0;

        return await ds_response.patch(overview.overviewPanel(evid, decs.size() as long, allow, stepUp, shadow, deny, covPct, hasPolicy, hasDecisions));
    }
}
