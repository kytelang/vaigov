// Overview dashboard as KYX, matching the Vue OverviewView.vue: a "Getting
// started" checklist, three stat tiles, a decision-posture bar + legend with the
// authored-control-coverage bar, and a control-plane badge strip. Themed classes
// only (bg-panel/border-line/text-dim/text-txt/text-accent/text-ok/text-warn/
// text-bad). Proportional bars are inline SVG (geometry attributes, not CSS
// inline styles) so they render under the strict style-src 'self' CSP.

// One checklist step: a numbered (or ticked) circle, the step text, a hint, and
// an "open" affordance.
fn overviewStep(n: int, done: bool, title: string, hint: string): Html {
    return <li class="flex items-start gap-3">
        {if (done) {
            <span class="mt-0.5 w-5 h-5 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold bg-panel2 text-ok">✓</span>;
        } else {
            <span class="mt-0.5 w-5 h-5 shrink-0 rounded-full flex items-center justify-center text-[11px] font-bold bg-panel2 text-dim border border-line">{n}</span>;
        }}
        <div class="flex-1 min-w-0">
            {if (done) {
                <div class="text-sm text-dim line-through">{title}</div>;
            } else {
                <div class="text-sm text-txt">{title}</div>;
            }}
            <div class="text-xs text-dim">{hint}</div>
        </div>
        <span class="text-xs text-accent shrink-0">open →</span>
    </li>;
}

pub fn overviewPanel(evidence: long, decisions: long, allow: long, stepUp: long, shadow: long, deny: long, covPct: int, hasPolicy: bool, hasDecisions: bool): Html {
    let total = allow + stepUp + shadow + deny;
    let wa = if (total > 0) (allow * 100 / total) else (0 as long);
    let ws = if (total > 0) (stepUp * 100 / total) else (0 as long);
    let wsh = if (total > 0) (shadow * 100 / total) else (0 as long);
    let wd = if (total > 0) (deny * 100 / total) else (0 as long);
    let xs = wa;
    let xsh = wa + ws;
    let xd = wa + ws + wsh;

    return <div id="overview" class="grid gap-4">

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <div class="bg-panel border border-line rounded-xl px-5 py-4">
                <div class="text-2xl font-semibold text-txt">{evidence}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Evidence records</div>
            </div>
            <div class="bg-panel border border-line rounded-xl px-5 py-4">
                <div class="text-2xl font-semibold text-accent">{decisions}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Decisions</div>
            </div>
            {if (deny > 0) {
                <div class="bg-panel border border-line rounded-xl px-5 py-4">
                    <div class="text-2xl font-semibold text-bad">{deny}</div>
                    <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Denied</div>
                </div>;
            } else {
                <div class="bg-panel border border-line rounded-xl px-5 py-4">
                    <div class="text-2xl font-semibold text-ok">{deny}</div>
                    <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Denied</div>
                </div>;
            }}
        </div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-line">
                <h2 class="font-semibold text-txt">Decision posture</h2>
                <p class="text-xs text-dim">live, refreshed on load</p>
            </div>
            <div class="px-5 py-4">
                <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="w-full h-2 rounded-full overflow-hidden bg-panel2">
                    <rect x="0" y="0" width={`${wa}`} height="6" class="fill-ok" />
                    <rect x={`${xs}`} y="0" width={`${ws}`} height="6" class="fill-warn" />
                    <rect x={`${xsh}`} y="0" width={`${wsh}`} height="6" class="fill-accent" />
                    <rect x={`${xd}`} y="0" width={`${wd}`} height="6" class="fill-bad" />
                </svg>
                <div class="mt-3 flex flex-wrap items-center gap-4 text-sm">
                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-ok"></span><span class="text-dim">allow</span> <b class="text-txt">{allow}</b></span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-warn"></span><span class="text-dim">step_up</span> <b class="text-txt">{stepUp}</b></span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-accent"></span><span class="text-dim">shadow</span> <b class="text-txt">{shadow}</b></span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-bad"></span><span class="text-dim">deny</span> <b class="text-txt">{deny}</b></span>
                </div>
                <div class="mt-4 flex items-center gap-3 text-sm">
                    <span class="text-dim">Control coverage (authored)</span>
                    <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="h-2 rounded-full overflow-hidden bg-panel2 flex-1 max-w-xs">
                        <rect x="0" y="0" width={`${covPct}`} height="6" class="fill-accent" />
                    </svg>
                    <b class="text-txt">{covPct}%</b>
                </div>
            </div>
        </div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-3 border-b border-line"><h2 class="font-semibold text-txt">Control plane</h2></div>
            <div class="px-5 py-4 flex flex-wrap gap-2 text-sm">
                <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-panel2 text-ok">server online</span>
                {if (deny > 0) {
                    <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-panel2 text-bad">{deny} denied</span>;
                } else {
                    <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-panel2 text-ok">no denials</span>;
                }}
                <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-panel2 text-accent">tenant scoped</span>
            </div>
        </div>

    </div>;
}
