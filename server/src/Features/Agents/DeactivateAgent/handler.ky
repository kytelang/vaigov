// POST /agents/{id}/deactivate -> {"ok":true,"id":...}.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Agents.Shared.AgentRepository;

pub struct DeactivateAgentHandler impl RouteHandler {
    repo: AgentRepository,
    app: AppContext,
    init(repo: AgentRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: DeactivateAgentHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.RegisterAgent)) { return Http.forbidden(); }
        let id = ctx.param("id");
        await self.repo.deactivate(id);
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("ok", json.bool(true));
        m.set("id", json.str(id));
        return Http.okObj(m);
    }
}
