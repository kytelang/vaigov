// POST /agents/{id}/update {name, owner, metadata} -> {"ok":true}.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Agents.Shared.AgentRepository;
import Features.Apps.CreateApp.handler;

pub struct UpdateAgentHandler impl RouteHandler {
    repo: AgentRepository,
    app: AppContext,
    init(repo: AgentRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: UpdateAgentHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.RegisterAgent)) { return Http.forbidden(); }
        let id = ctx.param("id");
        let body = Http.bodyJson(ctx);
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        await self.repo.update(id, bodyStr(body, "name"), bodyStr(body, "owner"), bodyMeta(body), tenant);
        let m = Map<string, json.JsonValue>(1, string.hash);
        m.set("ok", json.bool(true));
        return Http.okObj(m);
    }
}
