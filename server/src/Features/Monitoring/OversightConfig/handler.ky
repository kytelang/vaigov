// POST /oversight/config -> {"ok":true,"config":cfg}. Update the thresholds,
// merging present body fields over the current config, persisted to control_state.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Monitoring.Shared.MonitorRepository;
import Features.Monitoring.Shared.monitorjson;

pub struct OversightConfigHandler impl RouteHandler {
    repo: MonitorRepository,
    app: AppContext,
    init(repo: MonitorRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: OversightConfigHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditGrc)) { return Http.forbidden(); }
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let key = string.concat("oversight:config:", tenant);
        let cur = monitorjson.oversightConfigOf(await self.repo.getState(key));
        let body = Http.bodyJson(ctx);
        let cfg = monitorjson.mergeOversightConfig(cur, body);
        await self.repo.putState(key, json.stringify(cfg), Http.nowMs());
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("ok", json.bool(true));
        m.set("config", cfg);
        return Http.okObj(m);
    }
}
