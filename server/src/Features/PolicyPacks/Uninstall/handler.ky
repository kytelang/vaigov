// POST /policy-packs/{slug}/uninstall -> disable the rules this pack generated.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.PolicyPacks.Shared.PackRepository;

pub struct UninstallHandler impl RouteHandler {
    repo: PackRepository,
    app: AppContext,
    init(repo: PackRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: UninstallHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditPolicy)) { return Http.forbidden(); }
        let slug = ctx.param("slug");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let n = await self.repo.uninstall(tenant, slug);
        let m = Map<string, json.JsonValue>(3, string.hash);
        m.set("ok", json.bool(true));
        m.set("slug", json.str(slug));
        m.set("rules_disabled", json.number(n));
        return Http.okObj(m);
    }
}
