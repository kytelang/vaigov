// Policy packs view as KYX (matches acp/console PacksView.vue): the curated
// enforceable rule sets per act, one card each, with install state badges. The
// install / upgrade / uninstall actions (which post parameters and re-compile the
// policy) are a follow-up; this renders the catalogue with live install state.
import list;
import string;

fn jsq(s: string): string { let a = string.replace(s, "\\", "\\\\"); return string.replace(a, "'", "\\'"); }

// Reference-typed view model so the card list carries its owned strings cleanly.
pub class PackCard {
    pub slug: string,
    pub title: string,
    pub frameworkSlug: string,
    pub region: string,
    pub description: string,
    pub version: int,
    pub installedVersion: int,
    pub installed: bool,
    pub updateAvailable: bool,
    init(slug: string, title: string, frameworkSlug: string, region: string, description: string, version: int, installedVersion: int, installed: bool, updateAvailable: bool) {
        self.slug = slug; self.title = title; self.frameworkSlug = frameworkSlug; self.region = region;
        self.description = description; self.version = version; self.installedVersion = installedVersion;
        self.installed = installed; self.updateAvailable = updateAvailable;
    }
}

fn metaChip(t: string): Html {
    if (t.length == 0) { return <span></span>; }
    return <span class="text-xs px-2 py-0.5 rounded-md bg-panel2 border border-line text-dim">{t}</span>;
}

fn packCard(p: PackCard): Html {
    return <div class="bg-panel border border-line rounded-xl p-5">
        <div class="flex items-start gap-3">
            <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-semibold text-txt">{p.title}</h3>
                    {metaChip(p.frameworkSlug)}
                    {metaChip(p.region)}
                    {if (p.installed) {
                        <span class="text-xs px-2 py-0.5 rounded-md bg-panel2 border border-line text-ok">{`installed v${p.installedVersion}`}</span>;
                    }}
                    {if (p.updateAvailable) {
                        <span class="text-xs px-2 py-0.5 rounded-md bg-panel2 border border-line text-warn">update available</span>;
                    }}
                </div>
                <p class="text-sm text-dim mt-1">{p.description}</p>
                <p class="text-xs text-dim mt-1">{`pack version ${p.version}`}</p>
            </div>
            <div class="ml-auto shrink-0 flex items-center gap-2">
                {if (p.installed) {
                    <button class="rounded-lg border border-line2 px-3.5 py-1.5 text-sm font-medium hover:bg-panel2"
                        data-on:click={"$pkSlug='" + jsq(p.slug) + "'; @post('/console/packs/uninstall')"}>Uninstall</button>;
                } else {
                    <button class="rounded-lg bg-accent text-white px-3.5 py-1.5 text-sm font-medium hover:opacity-90"
                        data-on:click={"$pkSlug='" + jsq(p.slug) + "'; @post('/console/packs/install')"}>Install</button>;
                }}
                {if (p.updateAvailable) {
                    <button class="rounded-lg bg-accent text-white px-3.5 py-1.5 text-sm font-medium hover:opacity-90"
                        data-on:click={"$pkSlug='" + jsq(p.slug) + "'; @post('/console/packs/install')"}>Update</button>;
                }}
            </div>
        </div>
    </div>;
}

pub fn packsPanel(packs: list.List<PackCard>): Html {
    return <div id="packs" class="grid gap-4">
        <div data-show="$pkMsg != ''" class="text-sm text-ok bg-panel2 border border-line rounded-md px-3 py-2" data-text="$pkMsg"></div>
        {for (i in 0..packs.size()) { packCard(packs.at(i)); }}
        {if (packs.size() == 0) {
            <p class="text-sm text-dim py-6 text-center">No policy packs available.</p>;
        }}
    </div>;
}
