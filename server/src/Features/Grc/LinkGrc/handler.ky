// POST /grc/{id}/link {id,type?} -> {"ok":true,"id","linked"}. Appends an advisory
// linked reference to the record's linked_refs (unsigned workflow metadata).
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Grc.Shared.GrcRepository;
import Features.Grc.AssessGrc.handler;
import Domain.Dtos.GrcRow;

pub struct LinkGrcHandler impl RouteHandler {
    repo: GrcRepository,
    app: AppContext,
    init(repo: GrcRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: LinkGrcHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditGrc)) { return Http.forbidden(); }
        let recId = ctx.param("id");
        let body = Http.bodyJson(ctx);
        let linkId = if (body.kind == 5 && json.has(body, "id")) (string.trim(json.asString(json.get(body, "id")) ?? "")) else ("");
        if (linkId.length == 0) { return grcErr("id is required"); }
        let linkType = if (body.kind == 5 && json.has(body, "type")) (json.asString(json.get(body, "type")) ?? "ref") else ("ref");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let recs = await self.repo.get(recId);
        if (recs.items.size() == 0) { return grcErr("no such record"); }
        let rec = recs.items.getOr(0, GrcRow{ id: "", kind: "", subject: "", title: "", status: "", body: "{}", operator: "", created_ms: 0, pubkey_hex: "", sig_hex: "", linked_refs: "[]", answers_json: "{}", assignee: "", due_ms: 0, stage: "", tenant: "" });
        if (!string.eql(rec.tenant, tenant)) { return grcErr("no such record"); }

        let refsV = json.tryParse(rec.linked_refs) ?? json.array(list.List<json.JsonValue>());
        let refsArr = json.asArray(refsV) ?? list.List<json.JsonValue>();
        let one = Map<string, json.JsonValue>(2, string.hash);
        one.set("type", json.str(linkType));
        one.set("id", json.str(linkId));
        refsArr.push(json.object(one));
        await self.repo.setLinkedRefs(recId, json.stringify(json.array(refsArr)));

        let m = Map<string, json.JsonValue>(3, string.hash);
        m.set("ok", json.bool(true));
        m.set("id", json.str(recId));
        m.set("linked", json.str(linkId));
        return Http.okObj(m);
    }
}
