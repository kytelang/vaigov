// GET /grc/{id}/comments -> {"comments":[{id,author,body,created_ms}]} (tenant-scoped).
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Features.Grc.Shared.GrcRepository;
import Domain.Dtos.GrcRow;

pub struct CommentsGetHandler impl RouteHandler {
    repo: GrcRepository,
    app: AppContext,
    init(repo: GrcRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: CommentsGetHandler, ctx: routing.Context): response.Response {
        let recId = ctx.param("id");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let empty = Map<string, json.JsonValue>(2, string.hash);
        empty.set("comments", json.array(list.List<json.JsonValue>()));
        let recs = await self.repo.get(recId);
        if (recs.items.size() == 0) { return Http.okObj(empty); }
        let rec = recs.items.getOr(0, GrcRow{ id: "", kind: "", subject: "", title: "", status: "", body: "{}", operator: "", created_ms: 0, pubkey_hex: "", sig_hex: "", linked_refs: "[]", answers_json: "{}", assignee: "", due_ms: 0, stage: "", tenant: "" });
        if (!string.eql(rec.tenant, tenant)) { return Http.okObj(empty); }

        let cs = await self.repo.listComments(recId);
        let arr = list.List<json.JsonValue>();
        let i = 0;
        while (i < cs.items.size()) {
            let c = cs.items.getOr(i, GrcCommentRow{ id: "", author: "", body: "", created_ms: 0 });
            let m = Map<string, json.JsonValue>(4, string.hash);
            m.set("id", json.str(c.id));
            m.set("author", json.str(c.author));
            m.set("body", json.str(c.body));
            m.set("created_ms", json.number(c.created_ms));
            arr.push(json.object(m));
            i = i + 1;
        }
        let out = Map<string, json.JsonValue>(2, string.hash);
        out.set("comments", json.array(arr));
        return Http.okObj(out);
    }
}
