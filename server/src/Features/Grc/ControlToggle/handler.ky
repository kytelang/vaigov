// POST /grc/{id}/control/{control_id} {done?} -> {"ok":true}. Toggles a control's
// done flag in the record's checklist and re-signs the record (acp A1).
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Grc.Shared.GrcRepository;
import Features.Grc.Shared.grcsign;
import Features.Grc.AssessGrc.handler;
import Domain.Dtos.GrcRow;

pub struct ControlToggleHandler impl RouteHandler {
    repo: GrcRepository,
    app: AppContext,
    init(repo: GrcRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: ControlToggleHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditGrc)) { return Http.forbidden(); }
        let recId = ctx.param("id");
        let controlId = ctx.param("control_id");
        let body = Http.bodyJson(ctx);
        let doneVal = if (body.kind == 5 && json.has(body, "done")) (json.asBool(json.get(body, "done")) ?? true) else (true);
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let recs = await self.repo.get(recId);
        if (recs.items.size() == 0) { return grcErr("no such record"); }
        let rec = recs.items.getOr(0, GrcRow{ id: "", kind: "", subject: "", title: "", status: "", body: "{}", operator: "", created_ms: 0, pubkey_hex: "", sig_hex: "", linked_refs: "[]", answers_json: "{}", assignee: "", due_ms: 0, stage: "", tenant: "" });
        if (!string.eql(rec.tenant, tenant)) { return grcErr("no such record"); }

        let parsed = json.tryParse(rec.body) ?? json.object(Map<string, json.JsonValue>(2, string.hash));
        let objMap = json.asObject(parsed) ?? Map<string, json.JsonValue>(2, string.hash);
        let oldArr = if (json.has(parsed, "checklist")) (json.asArray(json.get(parsed, "checklist")) ?? list.List<json.JsonValue>()) else (list.List<json.JsonValue>());
        let newArr = list.List<json.JsonValue>();
        let found = false;
        let i = 0;
        while (i < oldArr.size()) {
            let it = oldArr.get(i) ?? json.null();
            let cid = if (it.kind == 5 && json.has(it, "control_id")) (json.asString(json.get(it, "control_id")) ?? "") else ("");
            if (string.eql(cid, controlId)) {
                let im = json.asObject(it) ?? Map<string, json.JsonValue>(2, string.hash);
                im.set("done", json.bool(doneVal));
                newArr.push(json.object(im));
                found = true;
            } else {
                newArr.push(it);
            }
            i = i + 1;
        }
        if (!found) {
            let nm = Map<string, json.JsonValue>(2, string.hash);
            nm.set("control_id", json.str(controlId));
            nm.set("done", json.bool(doneVal));
            newArr.push(json.object(nm));
        }
        objMap.set("checklist", json.array(newArr));
        let newBody = json.stringify(json.object(objMap));

        let doc = grcsign.grcDoc(rec.id, rec.kind, rec.subject, rec.title, rec.status, newBody);
        let sig = grcsign.grcSignHex(self.app.trust.keypair.privHex, doc);
        await self.repo.updateSigned(recId, rec.status, newBody, rec.stage, self.app.trust.keypair.pubHex, sig);
        let m = Map<string, json.JsonValue>(1, string.hash);
        m.set("ok", json.bool(true));
        return Http.okObj(m);
    }
}
