// POST /grc/{id}/usecase/{stage} -> {"ok":true,"id","stage"}. Advances a use-case
// record's lifecycle stage and re-signs it so verify-on-read stays valid.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Grc.Shared.GrcRepository;
import Features.Grc.Shared.grcsign;
import Features.Grc.AssessGrc.handler;
import Domain.Dtos.GrcRow;

pub struct UsecaseTransitionHandler impl RouteHandler {
    repo: GrcRepository,
    app: AppContext,
    init(repo: GrcRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: UsecaseTransitionHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditGrc)) { return Http.forbidden(); }
        let recId = ctx.param("id");
        let stage = ctx.param("stage");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let recs = await self.repo.get(recId);
        if (recs.items.size() == 0) { return grcErr("no such record"); }
        let rec = recs.items.getOr(0, GrcRow{ id: "", kind: "", subject: "", title: "", status: "", body: "{}", operator: "", created_ms: 0, pubkey_hex: "", sig_hex: "", linked_refs: "[]", answers_json: "{}", assignee: "", due_ms: 0, stage: "", tenant: "" });
        if (!string.eql(rec.tenant, tenant)) { return grcErr("no such record"); }
        let doc = grcsign.grcDoc(rec.id, rec.kind, rec.subject, rec.title, rec.status, rec.body);
        let sig = grcsign.grcSignHex(self.app.trust.keypair.privHex, doc);
        await self.repo.updateSigned(recId, rec.status, rec.body, stage, self.app.trust.keypair.pubHex, sig);
        let m = Map<string, json.JsonValue>(3, string.hash);
        m.set("ok", json.bool(true));
        m.set("id", json.str(recId));
        m.set("stage", json.str(stage));
        return Http.okObj(m);
    }
}
