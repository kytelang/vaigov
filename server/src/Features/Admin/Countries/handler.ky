// GET /countries -> {"countries":[{code,name,region}]}.
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Features.Admin.Shared.AdminRepository;
import Features.Admin.Shared.adminjson;

pub struct CountriesHandler impl RouteHandler {
    repo: AdminRepository,
    app: AppContext,
    init(repo: AdminRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: CountriesHandler, ctx: routing.Context): response.Response {
        let rows = await self.repo.countries();
        let arr = list.List<json.JsonValue>();
        let i = 0;
        while (i < rows.items.size()) {
            arr.push(adminCountryJson(rows.items.getOr(i, CountryRow{ code: "", name: "", region: "" })));
            i = i + 1;
        }
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("countries", json.array(arr));
        return Http.okObj(m);
    }
}
