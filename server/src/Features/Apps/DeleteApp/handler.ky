// POST /apps/{id}/delete -> {"ok":true}. Mirrors app_delete.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Apps.Shared.AppRepository;

pub struct DeleteAppHandler impl RouteHandler {
    repo: AppRepository,
    app: AppContext,
    init(repo: AppRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: DeleteAppHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.RegisterApp)) { return Http.forbidden(); }
        let id = ctx.param("id");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        await self.repo.remove(id, tenant);
        let m = Map<string, json.JsonValue>(1, string.hash);
        m.set("ok", json.bool(true));
        return Http.okObj(m);
    }
}
