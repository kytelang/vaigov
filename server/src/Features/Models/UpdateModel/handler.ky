// POST /models/{id}/update -> update a model (RegisterApp). acp model_update:
// body {name, provider, version, card}. Returns {ok:true}.
import web.routing;
import web.response;
import string;
import serde.json;
import Features.Models.Shared.ModelRepository;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;

pub struct ModelUpdateHandler impl RouteHandler {
    repo: ModelRepository,
    app: AppContext,
    init(repo: ModelRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: ModelUpdateHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Capability.RegisterApp)) { return Http.forbidden(); }
        let th = ctx.request.getHeader("x-acp-tenant");
        let tenant = if (th == undefined) (self.app.trustCfg.tenant) else (th ?? "");
        let id = ctx.param("id");
        let body = Http.bodyJson(ctx);
        let name = json.asString(json.get(body, "name")) ?? "";
        let provider = json.asString(json.get(body, "provider")) ?? "";
        let version = json.asString(json.get(body, "version")) ?? "";
        let card = if (json.has(body, "card")) (json.stringify(json.get(body, "card"))) else ("{}");
        await self.repo.update(id, name, provider, version, card, tenant);
        return Http.jsonResp("{\"ok\":true}");
    }
}
