// GET /models -> {"models": [ <model + atlas/atlas_detail>, ... ]} (acp models_list).
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Features.Models.Shared.ModelRepository;
import Features.Models.Shared.modeljson;
import Domain.Dtos.ModelRow;
import Shared.AppContext;
import Shared.Http;

pub struct ModelsListHandler impl RouteHandler {
    repo: ModelRepository,
    app: AppContext,
    init(repo: ModelRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: ModelsListHandler, ctx: routing.Context): response.Response {
        let th = ctx.request.getHeader("x-acp-tenant");
        let tenant = if (th == undefined) (self.app.trustCfg.tenant) else (th ?? "");
        let rows = await self.repo.list(tenant);
        let arr = List<json.JsonValue>();
        let i = 0;
        while (i < rows.items.size()) {
            let m = rows.items.getOr(i, ModelRow{ id: "", name: "", provider: "", version: "", card_json: "", scan_status: "", aibom_json: "", tenant: "", created_ms: 0 });
            arr.push(modelRowJson(m, true));
            i = i + 1;
        }
        let o = Map<string, json.JsonValue>(2, string.hash);
        o.set("models", json.array(arr));
        return Http.okObj(o);
    }
}
