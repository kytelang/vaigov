// Acts & controls view as KYX (matches acp/console ActsView.vue): the regulatory
// catalogue, each act a Card with its conformance controls. No literal braces in
// attribute values; themed palette throughout.
import list;
import string;
import controls;

// Obligation badge coloured like the Vue `otone`: prohibition->bad,
// technical/oversight->ok, otherwise dim.
fn actObligationBadge(t: string): Html {
    if (string.eql(t, "prohibition")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-bad">{t}</span>;
    } else if (string.eql(t, "technical") || string.eql(t, "oversight")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{t}</span>;
    } else if (t.length == 0) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">-</span>;
    } else {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">{t}</span>;
    }
}

fn actRolesText(c: controls.Control): string {
    if (c.roles.size() == 0) { return "any"; }
    let s = "";
    let i = 0;
    while (i < c.roles.size()) {
        if (i > 0) { s = string.concat(s, ", "); }
        s = string.concat(s, c.roles.at(i));
        i = i + 1;
    }
    return s;
}

// "Assessed by" (matches the Vue ActsView column). The varman control catalogue
// has no dedicated assessor field, so we show the accountable party: the first
// (primary) applicable role, which is who is responsible for assessing the
// control. Falls back to "-" when a control applies to any role.
fn actAssessedBy(c: controls.Control): string {
    if (c.roles.size() == 0) { return "-"; }
    return c.roles.at(0);
}

fn actControlRow(c: controls.Control): Html {
    return <tr class="border-b border-line align-top">
        <td class="py-2 pr-4 font-mono text-xs text-dim whitespace-nowrap">{c.reference}</td>
        <td class="py-2 pr-4">
            <div class="text-sm text-txt">{c.title}</div>
            {if (c.description.length > 0) { <div class="text-xs text-dim">{c.description}</div>; }}
        </td>
        <td class="py-2 pr-4">{actObligationBadge(c.obligationType)}</td>
        <td class="py-2 pr-4 text-xs text-dim">{actRolesText(c)}</td>
        <td class="py-2 pr-4 text-xs text-dim whitespace-nowrap">{actAssessedBy(c)}</td>
    </tr>;
}

fn actJsq(s: string): string { let a = string.replace(s, "\\", "\\\\"); return string.replace(a, "'", "\\'"); }

// Left-rail act selector item (matches the Vue two-pane master list). The active
// item is highlighted via a Datastar data-class object built as a string so the
// literal braces survive the KYX attribute parser.
fn actNavItem(fw: controls.Framework): Html {
    let nctrls = controls.forFramework(fw.slug).size() as int;
    let meta = fw.slug + " · v" + fw.version + " · " + `${nctrls}` + " controls";
    let sel = "$actSel === '" + actJsq(fw.slug) + "'";
    let dcls = "{'bg-panel2 text-txt border-accent': " + sel + "}";
    let click = "$actSel='" + actJsq(fw.slug) + "'";
    return <button class="w-full text-left border-l-2 border-transparent px-3 py-2 hover:bg-panel2 cursor-pointer" data-class={dcls} data-on:click={click}>
        <div class="text-sm text-txt font-medium">{fw.label}</div>
        <div class="text-[11px] text-dim mt-0.5">{meta}</div>
        {if (fw.frameworkType.length > 0) { <div class="text-[10px] uppercase tracking-wide text-muted mt-0.5">{fw.frameworkType}</div>; }}
    </button>;
}

fn actCard(fw: controls.Framework): Html {
    let ctrls = controls.forFramework(fw.slug);
    let meta = string.concat(string.concat(string.concat(fw.slug, " · v"), fw.version), string.concat(" · ", fw.frameworkType));
    let show = "$actSel === '" + actJsq(fw.slug) + "'";
    return <div data-show={show} class="bg-panel border border-line rounded-xl">
        <div class="flex items-center justify-between gap-3 flex-wrap px-5 py-3 border-b border-line">
            <div>
                <h2 class="font-semibold text-txt">{fw.label}</h2>
                <p class="text-xs text-dim">{meta}</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-muted">{`${ctrls.size()} controls`}</span>
                {if (fw.source.length > 0) { <a href={fw.source} target="_blank" class="text-xs text-accent hover:underline">source</a>; }}
            </div>
        </div>
        <div class="px-5 py-4 overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-muted">
                        <th class="py-2 pr-4">Reference</th>
                        <th class="py-2 pr-4">Control</th>
                        <th class="py-2 pr-4">Obligation</th>
                        <th class="py-2 pr-4">Roles</th>
                        <th class="py-2 pr-4">Assessed by</th>
                    </tr>
                </thead>
                <tbody>
                    {for (j in 0..ctrls.size()) {
                        let copt = ctrls.get(j);
                        if (copt != undefined) {
                            actControlRow(copt ?? controls.makeControl("", "", "", "", "", "always", "", ""));
                        }
                    }}
                    {if (ctrls.size() == 0) {
                        <tr><td colspan="5" class="py-6 text-center text-dim">No controls.</td></tr>;
                    }}
                </tbody>
            </table>
        </div>
    </div>;
}

pub fn actsPanel(fws: list.List<controls.Framework>): Html {
    let totalCtrls = 0;
    let k = 0;
    while (k < fws.size()) { totalCtrls = totalCtrls + (controls.forFramework(fws.at(k).slug).size() as int); k = k + 1; }
    let firstSlug = if (fws.size() > 0) fws.at(0).slug else "";
    let sigs = "{actSel: '" + actJsq(firstSlug) + "'}";
    return <div id="acts" data-signals={sigs} class="grid gap-4">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{`${fws.size()} acts`}</span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-accent">{`${totalCtrls} controls`}</span>
            <span class="text-dim text-sm ml-2">The regulatory catalogue, served from the embedded acts and controls catalogue.</span>
        </div>
        {if (fws.size() == 0) {
            <p class="text-dim text-sm py-6 text-center">No acts.</p>;
        }}
        {if (fws.size() > 0) {
            <div class="grid md:grid-cols-[300px_1fr] gap-4 items-start">
                <div class="bg-panel border border-line rounded-xl overflow-hidden">
                    <div class="px-4 py-3 border-b border-line"><h2 class="font-semibold text-txt text-sm">Regulatory acts</h2></div>
                    <div class="divide-y divide-line">
                        {for (i in 0..fws.size()) {
                            let fw = fws.getOr(i, controls.Framework{ slug: "", label: "", version: "", frameworkType: "", effectiveDate: "", recordKeepingReference: "", source: "" });
                            actNavItem(fw);
                        }}
                    </div>
                </div>
                <div class="grid gap-4">
                    {for (i in 0..fws.size()) {
                        let fw = fws.getOr(i, controls.Framework{ slug: "", label: "", version: "", frameworkType: "", effectiveDate: "", recordKeepingReference: "", source: "" });
                        actCard(fw);
                    }}
                </div>
            </div>;
        }}
    </div>;
}
