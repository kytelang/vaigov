// Decisions view as KYX (matches acp/console DecisionsView.vue): the audit trail
// of what the policy did, every decision OPA pushed back from the enforcement
// point, newest first. Verdict badge: allow -> ok, deny -> bad, else warn.
import list;
import string;
import Domain.Dtos.DecisionDtos;

fn decVerdictBadge(v: string): Html {
    if (string.eql(v, "allow")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{v}</span>;
    } else if (string.eql(v, "deny")) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-bad">{v}</span>;
    } else if (v.length == 0) {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">-</span>;
    } else {
        return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-warn">{v}</span>;
    }
}

fn decDash(s: string): string { if (s.length == 0) { return "-"; } return s; }

// A stat tile matching ui/StatTile.vue: big value over an uppercase dim label.
fn statTile(value: int, label: string, tone: string): Html {
    let valCls = "text-2xl font-semibold " + tone;
    return <div class="bg-panel2 border border-line rounded-xl px-4 py-3">
        <div class={valCls}>{`${value}`}</div>
        <div class="text-[11px] uppercase tracking-wide text-dim mt-0.5">{label}</div>
    </div>;
}

// Compact control-count from the stored JSON array string (no JSON parse here):
// count quoted id entries so the column reads like the Vue chips count.
fn controlCount(j: string): int {
    if (j.length == 0 || string.eql(j, "[]")) { return 0; }
    let n = 0;
    let i = 0;
    while (i < j.length) { if (j[i] == 34) { n = n + 1; } i = i + 1; }
    return n / 2;
}

fn controlsCell(j: string): Html {
    let c = controlCount(j);
    if (c == 0) { return <span class="text-dim text-xs">-</span>; }
    return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-accent">{`${c}`}</span>;
}

fn decisionRow(d: DecisionRaw): Html {
    return <tr class="border-b border-line align-top">
        <td class="py-2 pr-4 whitespace-nowrap text-dim text-xs">{decDash(d.ts_text)}</td>
        <td class="py-2 pr-4">{decVerdictBadge(d.verdict)}</td>
        <td class="py-2 pr-4 text-xs text-dim">{decDash(d.subject)}</td>
        <td class="py-2 pr-4 text-sm text-txt">{decDash(d.resource)}</td>
        <td class="py-2 pr-4 text-xs text-dim">{decDash(d.operation)}</td>
        <td class="py-2 pr-4">{controlsCell(d.controls_json)}</td>
        <td class="py-2 pr-4 font-mono text-xs text-dim">{decDash(d.rule_id)}</td>
        <td class="py-2 pr-4 font-mono text-xs text-muted">{decDash(d.bundle_revision)}</td>
    </tr>;
}

pub fn decisionsPanel(rows: list.List<DecisionRaw>): Html {
    let allowed = 0;
    let denied = 0;
    let stepup = 0;
    let i = 0;
    while (i < rows.size()) {
        let v = rows.at(i).verdict;
        if (string.eql(v, "allow")) { allowed = allowed + 1; }
        else if (string.eql(v, "deny")) { denied = denied + 1; }
        else if (string.eql(v, "step_up")) { stepup = stepup + 1; }
        i = i + 1;
    }
    return <div id="decisions" class="grid gap-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {statTile(allowed, "Allowed", "text-ok")}
            {statTile(denied, "Denied", "text-bad")}
            {statTile(stepup, "Step-up", "text-warn")}
            {statTile(rows.size(), "Total logged", "text-txt")}
        </div>
        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-3 border-b border-line">
                <h2 class="font-semibold text-txt">Decisions</h2>
                <p class="text-xs text-dim">The audit trail of what the policy did: every decision OPA pushed back from the enforcement point, newest first.</p>
            </div>
            <div class="px-5 py-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead><tr class="text-left text-[11px] uppercase tracking-wider text-muted">
                        <th class="py-2 pr-4">When</th><th class="py-2 pr-4">Verdict</th><th class="py-2 pr-4">Subject</th><th class="py-2 pr-4">Resource</th><th class="py-2 pr-4">Operation</th><th class="py-2 pr-4">Controls</th><th class="py-2 pr-4">Rule</th><th class="py-2 pr-4">Bundle</th>
                    </tr></thead>
                    <tbody>
                        {for (i in 0..rows.size()) { decisionRow(rows.at(i)); }}
                        {if (rows.size() == 0) {
                            <tr><td colspan="8" class="py-10 text-center text-dim">No decisions yet. Once the OPA sidecar is enforcing policy at your firewall, every decision it makes streams back here.</td></tr>;
                        }}
                    </tbody>
                </table>
            </div>
        </div>
    </div>;
}
