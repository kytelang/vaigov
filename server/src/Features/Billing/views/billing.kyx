// Billing + usage console screen (docs/relevance-saas.md §4): the tenant's current
// plan, this month's governed-decision usage against the plan quota, a short usage
// history, and the plan catalogue with switch buttons. Datastar posts to
// /console/billing/select. A loop yields by calling a row helper (an inline element
// after a `let` does not compile in KYX).
import list;
import string;
import Features.Billing.Shared.plans;
import Domain.Dtos.BillingRows;

fn statusBadge(s: string): Html {
    if (string.eql(s, "active")) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-ok">{s}</span>; }
    if (string.eql(s, "past_due") || string.eql(s, "canceled")) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-bad">{s}</span>; }
    if (s.length == 0) { return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-dim">-</span>; }
    return <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-warn">{s}</span>;
}

fn usageRowHtml(u: UsageRow): Html {
    return <tr class="border-b border-line align-top">
        <td class="py-2 pr-4 font-mono text-xs text-dim">{u.period}</td>
        <td class="py-2 pr-4 text-sm text-txt">{`${u.decisions_count}`}</td>
    </tr>;
}

fn planCard(p: plans.Plan, currentSlug: string): Html {
    let isCurrent = string.eql(p.slug, currentSlug);
    let cardCls = if (isCurrent) ("bg-panel border border-accent rounded-xl p-5") else ("bg-panel border border-line rounded-xl p-5");
    let select = "$blPlan='" + p.slug + "'; @post('/console/billing/select')";
    return <div class={cardCls}>
        <div class="flex items-center justify-between">
            <h3 class="font-semibold text-txt">{p.name}</h3>
            {if (isCurrent) { <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-panel2 text-accent">current</span>; }}
        </div>
        <div class="text-2xl font-semibold text-txt mt-2">{plans.priceLabel(p)}</div>
        <div class="text-xs text-dim mt-1">{plans.quotaLabel(p)}</div>
        <p class="text-sm text-dim mt-3">{p.blurb}</p>
        <div class="mt-4">
            {if (isCurrent) {
                <button class="rounded-lg border border-line2 px-4 py-2 text-sm text-dim w-full" disabled="true">Current plan</button>;
            }}
            {if (!isCurrent) {
                <button class="rounded-lg bg-accent text-white px-4 py-2 text-sm font-medium hover:opacity-90 w-full" data-on:click={select}>{"Switch to " + p.name}</button>;
            }}
        </div>
    </div>;
}

pub fn billingPanel(current: plans.Plan, status: string, used: long, recent: list.List<UsageRow>, cat: list.List<plans.Plan>): Html {
    let sigs = "{blPlan: '', blMsg: '', blCheckout: ''}";
    let quota = current.quota;
    let pct = if (quota > 0) (if (used * 100 / quota > 100) (100) else ((used * 100 / quota) as int)) else (0);
    let barW = `${pct}` + "%";
    let overTone = if (pct >= 90) ("bg-bad") else (if (pct >= 70) ("bg-warn") else ("bg-accent"));
    let usedLabel = if (quota < 0) (`${used}` + " decisions (unlimited plan)") else (`${used}` + " of " + `${quota}` + " decisions this month");
    return <div id="billing" data-signals={sigs} class="grid gap-4">
        <div data-show="$blMsg != ''" class="text-ok text-sm bg-panel2 border border-line rounded-md px-3 py-2" data-text="$blMsg"></div>
        <div data-show="$blCheckout != ''" class="flex items-center gap-3 bg-panel2 border border-accent rounded-md px-3 py-2">
            <span class="text-sm text-txt">Your secure checkout is ready.</span>
            <a data-attr-href="$blCheckout" target="_blank" class="rounded-lg bg-accent text-white px-4 py-1.5 text-sm font-medium hover:opacity-90">Continue to checkout</a>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-panel border border-line rounded-xl">
                <div class="px-5 py-3 border-b border-line"><h2 class="font-semibold text-txt">Current plan</h2></div>
                <div class="px-5 py-4 grid gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg font-semibold text-txt">{current.name}</span>
                        {statusBadge(status)}
                    </div>
                    <div class="text-sm text-dim">{plans.priceLabel(current)} · {plans.quotaLabel(current)}</div>
                </div>
            </div>
            <div class="bg-panel border border-line rounded-xl">
                <div class="px-5 py-3 border-b border-line"><h2 class="font-semibold text-txt">Usage this month</h2></div>
                <div class="px-5 py-4 grid gap-2">
                    <div class="text-sm text-txt">{usedLabel}</div>
                    {if (quota > 0) {
                        <div class="h-2 rounded-full bg-panel2 overflow-hidden"><div class={"h-full " + overTone} style={"width:" + barW}></div></div>;
                    }}
                </div>
            </div>
        </div>

        <div class="bg-panel border border-line rounded-xl">
            <div class="px-5 py-3 border-b border-line"><h2 class="font-semibold text-txt">Usage history</h2></div>
            <div class="px-5 py-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead><tr class="text-left text-[11px] uppercase tracking-wider text-muted"><th class="py-2 pr-4">Period</th><th class="py-2 pr-4">Governed decisions</th></tr></thead>
                    <tbody>
                        {for (i in 0..recent.size()) { usageRowHtml(recent.at(i)); }}
                        {if (recent.size() == 0) { <tr><td colspan="2" class="py-8 text-center text-dim">No usage recorded yet.</td></tr>; }}
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h2 class="font-semibold text-txt mb-2">Plans</h2>
            <div class="grid md:grid-cols-3 gap-4">
                {for (i in 0..cat.size()) { planCard(cat.at(i), current.slug); }}
            </div>
        </div>
    </div>;
}
