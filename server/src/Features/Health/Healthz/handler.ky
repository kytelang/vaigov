// GET /healthz and /liveness -> process liveness.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;

pub struct HealthzHandler impl RouteHandler {
    app: AppContext,
    init(app: AppContext) { self.app = app; }
    async fn serve(self: HealthzHandler, ctx: routing.Context): response.Response {
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("ok", json.bool(true));
        m.set("status", json.str("healthy"));
        return Http.okObj(m);
    }
}
