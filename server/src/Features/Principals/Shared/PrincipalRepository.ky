// PrincipalRepository: the `principals` table + the `control_state` KV used for the
// directory-group registry (groupreg:*). Mirrors acp store.rs.
import list;
import string;
import data.db;
import data.repository;
import Shared.Db;
import Domain.Dtos.PrincipalListRow;

pub struct PrincipalRepository {
    db: Db,
    init(db: Db) { self.db = db; }

    pub async fn list(self: PrincipalRepository, tenant: string): Rows<PrincipalListRow> {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(tenant));
        let r = await Repository<PrincipalListRow>(conn, "principals").query(
            "SELECT id, display, source, groups_json, created_ms FROM principals WHERE tenant_id = $1 ORDER BY id", p);
        self.db.pool.release(conn);
        return r;
    }

    pub async fn upsert(self: PrincipalRepository, id: string, display: string, source: string, groupsJson: string, tenant: string, nowMs: long): void {
        let conn = await self.db.pool.acquire();
        let d = list.List<DbValue>();
        d.push(db.dbText(id)); d.push(db.dbText(tenant));
        let _d = await conn.exec("DELETE FROM principals WHERE id = $1 AND tenant_id = $2", d);
        let p = list.List<DbValue>();
        p.push(db.dbText(id)); p.push(db.dbText(display)); p.push(db.dbText(source));
        p.push(db.dbText(groupsJson)); p.push(db.dbText(tenant)); p.push(db.dbLong(nowMs));
        let _i = await conn.exec("INSERT INTO principals (id, display, source, groups_json, tenant_id, created_ms) VALUES ($1, $2, $3, $4, $5, $6)", p);
        self.db.pool.release(conn);
    }

    pub async fn putState(self: PrincipalRepository, key: string, value: string, nowMs: long): void {
        let conn = await self.db.pool.acquire();
        let d = list.List<DbValue>();
        d.push(db.dbText(key));
        let _d = await conn.exec("DELETE FROM control_state WHERE k = $1", d);
        let p = list.List<DbValue>();
        p.push(db.dbText(key)); p.push(db.dbText(value)); p.push(db.dbLong(nowMs));
        let _i = await conn.exec("INSERT INTO control_state (k, v, updated_ms) VALUES ($1, $2, $3)", p);
        self.db.pool.release(conn);
    }

    pub async fn listStatePrefix(self: PrincipalRepository, prefix: string): Rows<KvRow> {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(string.concat(prefix, "%")));
        let r = await Repository<KvRow>(conn, "control_state").query("SELECT k, v FROM control_state WHERE k LIKE $1", p);
        self.db.pool.release(conn);
        return r;
    }
}
