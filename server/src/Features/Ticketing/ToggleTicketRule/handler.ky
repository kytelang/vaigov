// POST /ticket-rules/{id}/toggle (EditPolicy). Body {enabled:bool}. -> {"ok":true}.
import web.routing;
import web.response;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Shared.Auth;
import Features.Ticketing.Shared.TicketRepository;

pub struct ToggleTicketRuleHandler impl RouteHandler {
    repo: TicketRepository,
    app: AppContext,
    init(repo: TicketRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: ToggleTicketRuleHandler, ctx: routing.Context): response.Response {
        if (!Http.requireCap(self.app, ctx, Auth.Capability.EditPolicy)) { return Http.forbidden(); }
        let id = ctx.param("id");
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let body = Http.bodyJson(ctx);
        let enabled = json.asBool(json.get(body, "enabled")) ?? true;
        await self.repo.setEnabled(id, tenant, enabled);
        let m = Map<string, json.JsonValue>(1, string.hash);
        m.set("ok", json.bool(true));
        return Http.okObj(m);
    }
}
