// POST /tickets/callback : inbound ticket-system resolution (HMAC-verified over the raw body with
// the webhook secret). No webhook secret is configured in this build, so it returns acp's
// secret-unset path (403). STUB: apply-resolution (approve/deny/grc-status) is a later wave.
import web.routing;
import web.response;
import web.status;
import string;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;

pub struct TicketCallbackHandler impl RouteHandler {
    app: AppContext,
    init(app: AppContext) { self.app = app; }

    async fn serve(self: TicketCallbackHandler, ctx: routing.Context): response.Response {
        let m = Map<string, json.JsonValue>(2, string.hash);
        m.set("ok", json.bool(false));
        m.set("error", json.str("ticket callbacks require --webhook-secret"));
        return Http.jsonStatus(Status.Forbidden, json.stringify(json.object(m)));
    }
}
