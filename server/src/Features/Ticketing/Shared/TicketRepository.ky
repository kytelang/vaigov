// TicketRepository: the ticket_rules + tickets tables in the shared `acp` db.
// SQL mirrors acp-server store.rs exactly (tenant_id, enabled INTEGER).
import list;
import string;
import data.db;
import data.repository;
import Shared.Db;
import Domain.Dtos.TicketRuleRow;

pub struct TicketRepository {
    db: Db,
    init(db: Db) { self.db = db; }

    pub async fn listRules(self: TicketRepository, tenant: string): Rows<TicketRuleRow> {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(tenant));
        let r = await Repository<TicketRuleRow>(conn, "ticket_rules").query(
            "SELECT id, name, enabled, match_verdict, match_control, match_resource, connector, target_json, throttle_sec FROM ticket_rules WHERE tenant_id = $1 ORDER BY created_ms DESC", p);
        self.db.pool.release(conn);
        return r;
    }

    pub async fn addRule(self: TicketRepository, id: string, tenant: string, name: string, matchVerdict: string, matchControl: string, matchResource: string, connector: string, targetJson: string, throttle: int, nowMs: long): void {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(id)); p.push(db.dbText(tenant)); p.push(db.dbText(name));
        p.push(db.dbText(matchVerdict)); p.push(db.dbText(matchControl)); p.push(db.dbText(matchResource));
        p.push(db.dbText(connector)); p.push(db.dbText(targetJson)); p.push(db.dbInt(throttle)); p.push(db.dbLong(nowMs));
        let _r = await conn.exec("INSERT INTO ticket_rules (id, tenant_id, name, enabled, match_verdict, match_control, match_resource, connector, target_json, throttle_sec, created_ms) VALUES ($1, $2, $3, 1, $4, $5, $6, $7, $8, $9, $10)", p);
        self.db.pool.release(conn);
    }

    pub async fn setEnabled(self: TicketRepository, id: string, tenant: string, enabled: bool): void {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbInt(if (enabled) 1 else 0)); p.push(db.dbText(id)); p.push(db.dbText(tenant));
        let _r = await conn.exec("UPDATE ticket_rules SET enabled = $1 WHERE id = $2 AND tenant_id = $3", p);
        self.db.pool.release(conn);
    }

    pub async fn deleteRule(self: TicketRepository, id: string, tenant: string): void {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(id)); p.push(db.dbText(tenant));
        let _r = await conn.exec("DELETE FROM ticket_rules WHERE id = $1 AND tenant_id = $2", p);
        self.db.pool.release(conn);
    }

    pub async fn listTickets(self: TicketRepository, tenant: string): Rows<TicketRow> {
        let conn = await self.db.pool.acquire();
        let p = list.List<DbValue>();
        p.push(db.dbText(tenant));
        let r = await Repository<TicketRow>(conn, "tickets").query(
            "SELECT id, rule_id, decision_id, connector, external_id, status, title, hits, created_ms, last_sent_ms FROM tickets WHERE tenant_id = $1 ORDER BY last_sent_ms DESC LIMIT 200", p);
        self.db.pool.release(conn);
        return r;
    }
}
