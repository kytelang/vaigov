// GET /content-rules -> the SIGNED active content-rule set (enabled rules only),
// in the shape the edge sidecar's cfrule.parseSet expects. Signed with the trust
// key via Http.signConfig so the sidecar verifies it against cp_pubkey before
// enforcing (content-firewall-design §7, R5 + R4). This is the only machine
// endpoint the edge consumes.
import web.routing;
import web.response;
import string;
import list;
import map;
import serde.json;
import Shared.AppContext;
import Shared.Http;
import Features.ContentRules.Shared.ContentRuleRepository;
import Domain.Dtos.ContentRuleRow;

pub struct ActiveSetHandler impl RouteHandler {
    repo: ContentRuleRepository,
    app: AppContext,
    init(repo: ContentRuleRepository, app: AppContext) { self.repo = repo; self.app = app; }

    async fn serve(self: ActiveSetHandler, ctx: routing.Context): response.Response {
        let tenant = ctx.request.getHeader("x-acp-tenant") ?? self.app.trustCfg.tenant;
        let rows = await self.repo.listEnabled(tenant);
        let arr = list.List<json.JsonValue>();
        let i = 0;
        while (i < rows.items.size()) {
            let r = rows.items.getOr(i, ContentRuleRow{ id: "", name: "", kind: "substr", pattern: "", threshold: 0, target: "request", action: "shadow", severity: "medium", controls_json: "[]", enabled: 1 });
            let m = Map<string, json.JsonValue>(9, string.hash);
            m.set("id", json.str(r.id));
            m.set("name", json.str(r.name));
            m.set("kind", json.str(r.kind));
            m.set("pattern", json.str(r.pattern));
            m.set("threshold", json.number(r.threshold as long));
            m.set("target", json.str(r.target));
            m.set("action", json.str(r.action));
            m.set("severity", json.str(r.severity));
            let ctrls = json.tryParse(r.controls_json);
            m.set("controls", if (ctrls == undefined) (json.array(list.List<json.JsonValue>())) else (ctrls ?? json.array(list.List<json.JsonValue>())));
            arr.push(json.object(m));
            i = i + 1;
        }
        let out = Map<string, json.JsonValue>(1, string.hash);
        out.set("rules", json.array(arr));
        return Http.signedObj(self.app, out);
    }
}
